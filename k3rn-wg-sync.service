[Unit]
Description=K3RN WireGuard peer sync (reconciles wg0 from the Supabase wg_peers registry)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
# Reuses the addon's env (SUPABASE_URL + SUPABASE_SERVICE_KEY). Root: needs `wg set`.
EnvironmentFile=/etc/k3rn-capture.env
Environment=WG_IFACE=wg0
Environment=POLL_SECONDS=15
ExecStart=/usr/bin/python3 /home/ubuntu/wg_sync_agent.py
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
