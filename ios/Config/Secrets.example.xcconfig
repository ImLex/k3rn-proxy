// Copy to Config/Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
// NOTE: xcconfig treats `//` as a comment, so SUPABASE_HOST is the host only
// (no https://). The app prepends the scheme (see AppConfig.swift).
// The anon key is safe to embed in a client (RLS is the security boundary).

SUPABASE_HOST = eokucxysugglijyvhbdy.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key

DISCORD_GUILD_ID = 1511533461650014350
DISCORD_OFFICER_ROLE_ID = 1511533461675053086
DISCORD_K3RN_ROLE_ID = 1511533461666795578

// Signing (used by CI / local archive with automatic signing)
DEVELOPMENT_TEAM =

