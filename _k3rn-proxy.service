[Unit]
Description=K3RN capture proxy (mitmproxy + addon)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/k3rn-capture.env
ExecStart=/home/ubuntu/.local/bin/mitmdump --listen-host 0.0.0.0 --listen-port 8080 --set block_global=false --ignore-hosts '(.*\.)?apple\.com' --ignore-hosts '(.*\.)?icloud\.com' --ignore-hosts '(.*\.)?mzstatic\.com' --ignore-hosts '(.*\.)?push\.apple\.com' -s /home/ubuntu/k3rn_capture_addon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
